# --- DATABASE CONFIGURATION (TimescaleDB) ---
DB_USER=admin
DB_PASSWORD=sentinel_secure_pass_2026
DB_NAME=airsentinel_db
DB_HOST=localhost
DB_PORT=5432

# --- CACHE CONFIGURATION (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- STORAGE CONFIGURATION (MinIO) ---
MINIO_USER=storage_admin
MINIO_PASSWORD=minio_secret_vault_key
MINIO_ENDPOINT=http://localhost:9000

# --- MLflow TRACKING CONFIGURATION ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- LLM CONFIGURATION ---
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Optional fallback for AirSentinelAgent(provider="google"). Set either key;
# GEMINI_API_KEY takes precedence when both are defined.
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
GOOGLE_API_KEY=